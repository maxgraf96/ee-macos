@@ -620,4 +620,9 @@ DMAPI DmResult DmPerformance_renderPcm(DmPerformance* slf, void* buf, size_t num
 /// \param vol The new volume to set (between 0 and 1).
 DMAPI void DmPerformance_setVolume(DmPerformance* slf, float vol);
 
+/// EE port (local patch): master groove level offset, like DirectMusic's GUID_PerfMasterGrooveLevel.
+DMAPI void DmPerformance_setMasterGroove(DmPerformance* slf, int8_t level);
+/// EE port (local patch): like IDirectMusicSegment::SetRepeats.
+DMAPI void DmSegment_setRepeats(DmSegment* slf, uint32_t repeats);
