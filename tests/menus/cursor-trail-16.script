dump sweep

# Over the title, down to Single Player, and rest there for its tooltip.
move 700 150
wait frames 2
move 640 170
wait frames 2
move 580 190
wait frames 2
move 520 210
wait frames 2
move 480 240
wait frames 2
move 460 268
wait 2500
dump tooltip

move 150 700
wait still 8 within 10000
dump rest-after
quit
